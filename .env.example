# JSON array of browser origins allowed by CORS.
# Replace the example domain with the deployed Flutter Web origin.
CORS_ORIGINS='["http://localhost:3000","http://127.0.0.1:3000","https://your-flutter-web.example.com"]'

# Supabase Storage (backend only — never expose SERVICE_ROLE_KEY to Flutter)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_XRAY_BUCKET=xray-images
# Optional: signed URL lifetime in seconds (default 3600)
# SUPABASE_SIGNED_URL_EXPIRE_SECONDS=3600

# DenseNet121 Keras model (local filesystem path; do not commit the .keras binary)
AI_MODEL_PATH=app/ai/models/DenseNet121_best_restored.keras
# Real DenseNet121 inference (set false to force legacy Mock AI)
AI_INFERENCE_ENABLED=true
# TEMPORARY global multilabel threshold when model_backend_config.json is absent
AI_DECISION_THRESHOLD=0.5
